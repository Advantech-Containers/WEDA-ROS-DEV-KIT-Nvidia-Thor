# ==============================================================================
# WEDA ROS VLM — Static Configuration
# Dynamic values (DISPLAY, XAUTHORITY) are detected at runtime by build.sh.
# Application behavior lives in config/vlm_app.yaml — this file is deployment
# identity, licensing, and secrets only.
# ==============================================================================

# ── Images ────────────────────────────────────────────────────────────────────
# Shared WEDA vision base image (ROS 2 + CUDA CV stack). Bundle-specific
# runtime pieces (openai client, Orbbec SDK, rviz2) hydrate via entrypoint.sh.
WEDA_ROS_VLM_IMAGE=harbor.edgesync.cloud/weda-ai/weda-ros-cv:1.0.0-thor
# Serving image for the vlm-server service (the ROS image cannot `vllm serve`
# by design — fastapi/uvicorn are excluded; l3a-llm is the serving platform)
WEDA_VLM_SERVER_IMAGE=harbor.edgesync.cloud/weda-ai/weda-llm-base:1.0.0-thor

# Bind address for the inference API. Both services run with network_mode:
# host, so the ROS client reaches the server on 127.0.0.1 and loopback is
# enough. Set 0.0.0.0 only to call the API from another machine -- it is
# unauthenticated, so put a proxy with auth and TLS in front if you do.
VLM_SERVER_HOST=127.0.0.1

# ── Container Identity ────────────────────────────────────────────────────────
CONTAINER_NAME=weda-ros-vlm
SERVICE_NAME=weda-ros-vlm

# ── NVIDIA Runtime ────────────────────────────────────────────────────────────
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,video,graphics,display

# ── ROS 2 ─────────────────────────────────────────────────────────────────────
ROS_DISTRO=jazzy
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# ── Qt / GUI Stability (fixes qt.qpa.xcb errors in rviz2/rqt) ─────────────────
QT_X11_NO_MITSHM=1
NO_AT_SPI=1
DBUS_SESSION_BUS_ADDRESS=/dev/null

# ── Licensing (BYOL) ──────────────────────────────────────────────────────────
# build.sh prompts per session and never writes here. Permanent acceptance is
# YOUR choice: set true yourself (required for non-interactive/fleet deploys).
ACCEPT_COMMERCIAL_EULA=false
# Commercial pip packages the license gate installs at container start AFTER
# acceptance (never baked into the image). Ultralytics is handled automatically
# by the entrypoint after acceptance; list only ADDITIONAL packages here.
WISE_LICENSED_PIP=

# ── VLM server (vlm-server service) ───────────────────────────────────────────
# NOTE: this file is version-controlled as the deployment template. If you fill
# in a real token/credential below, do NOT commit that change.
# HuggingFace token — only needed for gated models
# HF_TOKEN=
# Host directory for model weights cache (default: ~/.cache/huggingface)
# HF_CACHE_DIR=

# ── Camera credentials (referenced from vlm_app.yaml as ${CAM_USER}/${CAM_PASS})
# CAM_USER=
# CAM_PASS=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_MAX_SIZE=50m
LOG_MAX_FILE=3
