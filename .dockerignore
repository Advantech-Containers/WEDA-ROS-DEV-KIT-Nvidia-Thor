# Keep custom-image build contexts small and license-clean: runtime-hydrated
# artifacts (model weights, engines) must never be baked into an image.
weda_ws/models/
weda_ws/*.pt
weda_ws/build/
weda_ws/install/
weda_ws/log/
weda_ws/Log/
weda_ws/reports/
weda_ws/.bench/
weda_ws/*.log
reports/
.git/
**/__pycache__/
*.log
dev/
*.engine
*.onnx
*.pyc
